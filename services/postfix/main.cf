

# Debian specific:  Specifying a file name will cause the first
# line of that file to be used as the name.  The Debian default
# is /etc/mailname.
mydomain = __MAIL_DOMAIN__
myorigin = $mydomain

smtpd_banner = $myhostname ESMTP
biff = no

# appending .domain is the MUA's job.
append_dot_mydomain = no

# Uncomment the next line to generate "delayed mail" warnings
#delay_warning_time = 4h

readme_directory = no

# See http://www.postfix.org/COMPATIBILITY_README.html -- default to 2 on
# fresh installs.
compatibility_level = 3.6



# TLS parameters
#smtpd_tls_cert_file=/etc/ssl/certs/ssl-cert-snakeoil.pem
#smtpd_tls_key_file=/etc/ssl/private/ssl-cert-snakeoil.key

smtpd_tls_cert_file=/etc/mailcore/tls/cert.pem
smtpd_tls_key_file=/etc/mailcore/tls/privkey.key
smtpd_use_tls=yes
smtpd_tls_mandatory_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtp_tls_mandatory_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtp_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtpd_tls_security_level=may
smtpd_tls_auth_only = yes
smtpd_tls_received_header = yes

smtp_tls_CApath=/etc/ssl/certs
smtp_tls_security_level=may
smtpd_tls_loglevel=1
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
smtp_tls_loglevel = 1

# Enable SASL authentication via Dovecot
# Enable Dovecot for SMTP AUTH
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_authenticated_header = yes

# Don't allow anonymous logins
smtpd_sasl_security_options = noanonymous
smtpd_sender_login_maps = proxy:pgsql:/etc/postfix/pgsql-sender-login.cf

# The default mail.local domain is development-only. Submission listeners
# invoke this class for mail.local senders; it permits local recipients only.
smtpd_restriction_classes = local_only_sender
local_only_sender = check_recipient_access proxy:pgsql:/etc/postfix/pgsql-local-recipient.cf, reject

# Workaround for some old mail clients
broken_sasl_auth_clients = yes

# Optional: leave local domain blank (depends on your setup)
smtpd_sasl_local_domain =

# Restrictions on who can send mail
smtpd_helo_required = yes
disable_vrfy_command = yes

smtpd_recipient_restrictions =
    reject_invalid_hostname,
    reject_non_fqdn_hostname,
    reject_non_fqdn_sender,
    reject_non_fqdn_recipient,
    reject_unknown_sender_domain,
    reject_unknown_recipient_domain,
    reject_unauth_pipelining,
    permit_sasl_authenticated,
    permit_mynetworks,
    reject_unauth_destination

smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated reject_unauth_destination
myhostname = __MAIL_HOSTNAME__
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
mydestination = localhost, localhost.localdomain
relayhost = 
# Public SMTP, submission, and SMTPS never trust the Docker service network.
# Only loopback is trusted by public SMTP listeners; scanning happens through
# the Rspamd Milter on the private filtering network.
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = all
inet_protocols = all


# My config

local_recipient_maps =

virtual_mailbox_domains = proxy:pgsql:/etc/postfix/pgsql-virtual-domains.cf
virtual_mailbox_maps    = proxy:pgsql:/etc/postfix/pgsql-virtual-users.cf
#   , proxy:mysql:/etc/postfix/sql/mysql_virtual_alias_domain_mailbox_maps.cf
virtual_alias_maps      = proxy:pgsql:/etc/postfix/pgsql-virtual-aliases.cf
#   , proxy:mysql:/etc/postfix/sql/mysql_virtual_alias_domain_maps.cf,
#   proxy:mysql:/etc/postfix/sql/mysql_virtual_alias_domain_catchall_maps.cf

#
submission_recipient_checks = reject_unknown_recipient_domain,permit_sasl_authenticated,reject_unauth_destination

submission_sender_checks = reject_sender_login_mismatch

smtpd_restriction_classes = submission_recipient_checks, submission_sender_checks
#

virtual_mailbox_base    = /var/mail/vhosts/

virtual_minimum_uid = 5000
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000

#transport_maps = proxy:mysql:/etc/postfix/sql/mysql_transport_maps.cf

# All SMTP and locally submitted mail passes through Rspamd. Rspamd performs
# spam/authentication checks and calls ClamAV directly via clamd INSTREAM.
# OpenDKIM signs outgoing mail and verifies inbound signatures.
smtpd_milters = inet:rspamd-filter:11332, inet:opendkim:8891
non_smtpd_milters = inet:rspamd-filter:11332, inet:opendkim:8891
# Fail closed: if either security/signing milter is unavailable, Postfix defers
# the message instead of accepting unscanned or unsigned mail.
milter_default_action = tempfail
milter_protocol = 6
milter_connect_timeout = 5s
milter_command_timeout = 30s
milter_content_timeout = 120s

# Rate limiting and anvil connection concurrency control (anti-bruteforce / anti-flood)
smtpd_client_connection_count_limit = 20
smtpd_client_connection_rate_limit = 60
smtpd_client_message_rate_limit = 120
smtpd_client_recipient_rate_limit = 240
smtpd_client_new_tls_session_rate_limit = 60

# Maximum message size (50MB) and header limits
message_size_limit = 52428800
header_size_limit = 102400

# Strict SMTP smuggling and syntax protections
smtpd_forbid_bare_newline = normalize
smtpd_data_restrictions = reject_unauth_pipelining

virtual_transport = lmtp:unix:private/dovecot-lmtp


# Hide software version from banner (stop fingerprinting)
# smtpd_banner configured above as: $myhostname ESMTP

# DANE / DNSSEC for outbound TLS verification (opportunistic)
smtp_dns_support_level = dnssec
# smtp_tls_security_level = may (configured above)
# smtp_tls_dane_insecure_mx_policy = dane

# Enable TLS session resumption (performance + security)
smtpd_tls_session_cache_timeout = 3600s
smtp_tls_session_cache_timeout = 3600s

# Modern TLS: prefer ECDHE ciphers, disable weak
smtpd_tls_ciphers = high
smtpd_tls_exclude_ciphers = aNULL, eNULL, EXPORT, DES, RC4, MD5, PSK, SRP, CAMELLIA
smtp_tls_ciphers = high
smtp_tls_exclude_ciphers = aNULL, eNULL, EXPORT, DES, RC4, MD5, PSK, SRP, CAMELLIA

# HELO/EHLO checks
smtpd_helo_restrictions =
    permit_mynetworks,
    reject_invalid_helo_hostname,
    reject_non_fqdn_helo_hostname

# Sender restrictions — authenticated users and local networks always permitted.
# Non-FQDN / unknown-domain senders are rejected only for unauthenticated sessions.
smtpd_sender_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_non_fqdn_sender,
    reject_unknown_sender_domain

# Bounce address rewriting (prevent backscatter)
bounce_notice_recipient = postmaster
delay_notice_recipient = postmaster
error_notice_recipient = postmaster

# Increase queue run frequency for time-sensitive mail
queue_run_delay = 300s
minimal_backoff_time = 300s
maximal_backoff_time = 4000s
maximal_queue_lifetime = 5d
bounce_queue_lifetime = 1d

# Reject common bogus HELO names (localhost, IP literals etc.)
smtpd_forbidden_commands = CONNECT, GET, POST

# SMTP smuggling defense (smtpd_forbid_bare_newline already set above)

# Postscreen (future-ready) - anvil rate stats logging
anvil_rate_time_unit = 60s
anvil_status_update_time = 600s

# Connection timeout hardening
smtpd_timeout = 300s
smtp_connect_timeout = 30s
smtp_helo_timeout = 30s
smtp_mail_timeout = 300s
smtp_rcpt_timeout = 300s
smtp_data_init_timeout = 120s
smtp_data_xfer_timeout = 180s
smtp_quit_timeout = 60s

# Max recipients per message (smtpd_expansion_limit is not a Postfix parameter)
smtpd_recipient_limit = 100
