driver = pgsql
connect = host=__MAIL_DB_HOST__ dbname=__MAIL_DB_NAME__ user=__MAIL_DB_USER__ password=__MAIL_DB_PASSWORD__

default_pass_scheme = BLF-CRYPT

password_query = \
  SELECT email as user, password \
  FROM virtual_users \
  WHERE email = '%u'

user_query = \
  SELECT \
    CONCAT('/var/mail/vhosts/', TRIM(TRAILING '/' FROM maildir)) AS home, \
    5000 AS uid, \
    5000 AS gid, \
    CASE \
      WHEN quota_bytes IS NOT NULL AND quota_bytes > 0 THEN CONCAT('*:storage=', quota_bytes, 'B') \
      ELSE '*:storage=0' \
    END AS quota_rule \
  FROM virtual_users \
  WHERE email = '%u'
