driver = pgsql
connect = host=mail_db dbname=mailserver user=mailuser password=__MAIL_DB_PASSWORD__

default_pass_scheme = BLF-CRYPT

password_query = \
  SELECT email as user, password \
  FROM virtual_users \
  WHERE email = '%u' AND active = true

user_query = \
  SELECT \
    CONCAT('/var/mail/vhosts/', TRIM(TRAILING '/' FROM maildir)) AS home, \
    5000 AS uid, \
    5000 AS gid \
  FROM virtual_users \
  WHERE email = '%u' AND active = true
