#!/bin/bash
set -e

DBPATH=/var/lib/spamassassin/.spamassassin
# Dovecot stores each account in /var/mail/vhosts/<domain>/<user>/Maildir.
SPAMFOLDER=/var/mail/vhosts/*/*/Maildir/Junk/cur
HAMFOLDER=/var/mail/vhosts/*/*/Maildir/cur

sa-learn --sync --dbpath $DBPATH
sa-learn --spam --dbpath $DBPATH $SPAMFOLDER || true
sa-learn --ham  --dbpath $DBPATH $HAMFOLDER || true
