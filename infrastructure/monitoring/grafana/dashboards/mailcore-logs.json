{
  "id": null,
  "uid": "mailcore-logs",
  "title": "MailCore Service Logs & Forensics",
  "tags": [
    "mailcore",
    "logs",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "query": "postfix,dovecot,admin-ui",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "postfix",
            "value": "postfix"
          },
          {
            "selected": false,
            "text": "dovecot",
            "value": "dovecot"
          },
          {
            "selected": false,
            "text": "admin-ui",
            "value": "admin-ui"
          }
        ]
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Search (Regex/Text)",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log Ingestion Rate by Service",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "mailcore-loki"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate({job=\"mailcore\", service=~\"$service\"} [$__rate_interval]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "logs/s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error & Rejection Rate",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "mailcore-loki"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate({job=\"mailcore\", service=~\"$service\"} |~ \"(?i)(error|fail|reject|fatal|warn)\" [$__rate_interval]))",
          "legendFormat": "{{service}} errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "events/s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Logs",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "mailcore-loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"mailcore\", service=~\"$service\"} [$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errors & Rejections (Window)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "mailcore-loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"mailcore\", service=~\"$service\"} |~ \"(?i)(error|fail|reject|fatal)\" [$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Postfix Rejections & Warnings",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "mailcore-loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"postfix\"} |~ \"(?i)(reject|bounced|warning)\" [$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Dovecot Auth Failures",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "mailcore-loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"dovecot\"} |~ \"(?i)(auth failed|unknown user|aborted)\" [$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Errors & Forensic Warnings (Filtered)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "loki",
        "uid": "mailcore-loki"
      },
      "targets": [
        {
          "expr": "{job=\"mailcore\", service=~\"$service\"} |~ \"(?i)(error|fail|reject|fatal|panic|warn)\" |~ \"(?i)$search\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Live MailCore Service Logs",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "loki",
        "uid": "mailcore-loki"
      },
      "targets": [
        {
          "expr": "{job=\"mailcore\", service=~\"$service\"} |~ \"(?i)$search\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}