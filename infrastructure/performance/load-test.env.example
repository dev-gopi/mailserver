# Copy to load-test.env and fill in a dedicated test mailbox.
# Never commit load-test.env; it contains an account password.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_TEST_SENDER=loadtest@example.com
SMTP_TEST_RECIPIENT=loadtest@example.com
SMTP_USERNAME=loadtest@example.com
SMTP_PASSWORD=replace-with-a-dedicated-test-mailbox-password
SMTP_CA_FILE=

IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USERNAME=loadtest@example.com
IMAP_PASSWORD=replace-with-a-dedicated-test-mailbox-password
IMAP_CA_FILE=
