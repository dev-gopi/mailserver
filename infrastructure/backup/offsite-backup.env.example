# Copy to secrets/runtime/offsite-backup.env with mode 0600.
# Never commit real credentials or the contents of RESTIC_PASSWORD_FILE.
RESTIC_REPOSITORY=s3:s3.amazonaws.com/replace-with-your-private-bucket/mailcore
RESTIC_PASSWORD_FILE=/etc/mailcore/restic-password
RESTIC_HOST=mailcore-primary
MAILCORE_RESTIC_TAG=mailcore
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
RESTIC_KEEP_YEARLY=2
RESTIC_CHECK_INTERVAL_HOURS=24
RESTIC_PRUNE_ENABLED=true
RESTIC_BACKUP_HOST_STATE=true
AWS_DEFAULT_REGION=ap-south-1

# Optional S3 credentials file (recommended over inline credentials):
# AWS_SHARED_CREDENTIALS_FILE=/etc/mailcore/aws-credentials
# For Backblaze B2 instead of S3, configure:
# B2_ACCOUNT_ID=replace-with-account-id
# B2_ACCOUNT_KEY=replace-with-application-key
# For a Restic REST server with authentication:
# RESTIC_REST_USERNAME=replace-with-username
# RESTIC_REST_PASSWORD=replace-with-password

# If the bucket has Object Lock/immutable retention, set RESTIC_PRUNE_ENABLED=false
# and configure lifecycle/retention in the cloud provider control plane.
