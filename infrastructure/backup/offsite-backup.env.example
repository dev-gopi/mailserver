# Copy to /etc/mailcore/offsite-backup.env and edit for your provider.
# Never commit real access credentials or RESTIC_PASSWORD_FILE contents.
RESTIC_REPOSITORY=s3:s3.amazonaws.com/replace-with-your-private-bucket/mailcore
RESTIC_PASSWORD_FILE=/etc/mailcore/restic-password
RESTIC_HOST=mailcore-primary
# Example S3-compatible credentials. Use IAM/instance roles where supported.
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
AWS_DEFAULT_REGION=ap-south-1
# Optional: keep 14 daily, 8 weekly and 12 monthly snapshots.
OFFSITE_APPLY_RETENTION=NO
OFFSITE_KEEP_DAILY=14
OFFSITE_KEEP_WEEKLY=8
OFFSITE_KEEP_MONTHLY=12
