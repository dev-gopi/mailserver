# MailCore host-side bans. Fail2ban runs on the host and reads only the
# dedicated authentication log bind mount; no Docker socket or container root is exposed.
[DEFAULT]
backend = auto
banaction = nftables-multiport
findtime = 10m
maxretry = 5
bantime = 1h
ignoreip = 127.0.0.1/8 ::1
usedns = no

[postfix-sasl]
enabled = true
filter = postfix-sasl
port = smtp,submission,submissions,465,587
logpath = /var/log/mailcore/postfix.log
maxretry = 5
findtime = 10m
bantime = 1h

[dovecot]
enabled = true
filter = dovecot
port = pop3,pop3s,imap,imaps,110,995,143,993
logpath = /var/log/mailcore/dovecot.log
maxretry = 5
findtime = 10m
bantime = 1h

[recidive]
enabled = true
filter = recidive
logpath = /var/log/fail2ban.log
backend = auto
maxretry = 5
findtime = 1d
bantime = 1w
