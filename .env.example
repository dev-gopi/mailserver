# Copy to .env before running Docker Compose. Do not commit the real file.
POSTGRES_DB=mailserver
POSTGRES_USER=mailuser
POSTGRES_PASSWORD=mailcore-local-development-password-change-before-public-use
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Local development default. mail.local is intentionally restricted to
# mail.local recipients; add and verify a real domain before public delivery.
MAIL_DOMAIN=mail.local
MAIL_HOSTNAME=mail.local
MAIL_PUBLIC_IP=
MX_PRIORITY=10
SPF_RECORD=v=spf1 mx ~all
DMARC_POLICY=quarantine
MONITOR_INTERVAL_SECONDS=60
ALERT_WEBHOOK_URL=
TZ=UTC
MAIL_ADMIN_USERNAME=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ADMIN_UI_PORT=8080
API_PORT=8080
ADMIN_UI_API_HOST=app
SMTP_PORT=25
SUBMISSION_PORT=587
SMTPS_PORT=465
IMAPS_PORT=993
IMAP_STARTTLS_PORT=143
POP3S_PORT=995
POP3_STARTTLS_PORT=110
REDIS_HOST=redis
REDIS_PORT=6379
POSTFIX_HOST=postfix
POSTFIX_PORT=25
POSTFIX_BRIDGE_PORT=2526
DOVECOT_HOST=dovecot
DOVECOT_PORT=993
SPAMASSASSIN_HOST=spamassassin
SPAMASSASSIN_PORT=783
CLAMAV_HOST=clamav-scanner
CLAMAV_PORT=3310
OPENDKIM_PORT=8891
# Local development only. Login: admin / MailCoreLocalOnly2026!
# Generate a replacement with: cd apps/admin-api && npm ci && node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
MAIL_ADMIN_PASSWORD_HASH='$2b$12$VdBYPN4ULb5IYRVTQnrnIuRD3UjvoE6l4s/txGXVmgY9JCQ/fkPb6'
# WebAuthn / Passkey configuration. Leave blank to use the browser-visible admin UI hostname.
# If set, use the public DNS hostname (not the Docker service name); localhost is valid for local use.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=MailCore Admin Console
# Required before enabling TOTP. Generate with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=
