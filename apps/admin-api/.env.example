# Copy to apps/admin-api/.env for local development. Do not use this file for secrets.
NODE_ENV=production
PORT=8080
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30
ADMIN_MAX_SESSIONS=5
SESSION_COOKIE_SECURE=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD_FILE=../../secrets/runtime/redis_password
REDIS_QUEUE=mail_tasks
POSTFIX_HOST=postfix
POSTFIX_PORT=25
POSTFIX_BRIDGE_PORT=2526
DOVECOT_HOST=dovecot
DOVECOT_PORT=993
SPAMASSASSIN_HOST=spamassassin
SPAMASSASSIN_PORT=783
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
IMAP_STARTTLS_ENABLED=false
POP3_STARTTLS_ENABLED=false
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
MAIL_PUBLIC_IP=
MX_PRIORITY=10
SPF_RECORD=v=spf1 mx ~all
DMARC_POLICY=quarantine
ALERT_WEBHOOK_URL=
PGHOST=db
PGPORT=5432
PGDATABASE=mailserver
PGUSER=mail_api
PGPASSWORD_FILE=../../secrets/runtime/api_db_password
# Optional WebAuthn relying-party ID. Use the browser-visible admin UI hostname, not "app".
# Leave blank to use the forwarded request hostname.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=MailCore Admin Console
# Required before enabling TOTP. Generate with: openssl rand -base64 32
# In Docker Compose, the persisted Docker secret file is used instead.
AUTH_ENCRYPTION_KEY_FILE=../../secrets/runtime/auth_encryption_key
