# Copy to apps/admin-api/.env for local development. Do not use this file for secrets.
NODE_ENV=production
PORT=8080
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_QUEUE=mail_tasks
POSTFIX_HOST=postfix
POSTFIX_PORT=25
POSTFIX_BRIDGE_PORT=2526
DOVECOT_HOST=dovecot
DOVECOT_PORT=993
SPAMASSASSIN_HOST=spamassassin
SPAMASSASSIN_PORT=783
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
MAIL_PUBLIC_IP=
MX_PRIORITY=10
SPF_RECORD=v=spf1 mx ~all
DMARC_POLICY=quarantine
ALERT_WEBHOOK_URL=
PGHOST=db
PGPORT=5432
PGDATABASE=mailserver
PGUSER=mailuser
PGPASSWORD=replace-with-a-strong-password
