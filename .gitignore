# Environment-specific secrets
.env
.env.*
!.env.example
apps/admin-api/.env
!apps/admin-api/.env.example
infrastructure/performance/load-test.env

# TLS and DKIM private material
secrets/tls/*
!secrets/tls/.gitkeep
secrets/runtime/*
!secrets/runtime/.gitkeep
opendkim/keys/

# Reports and generated audits
infrastructure/reports/*
!infrastructure/reports/.gitkeep
!infrastructure/reports/incidents/
!infrastructure/reports/incidents/.gitkeep

# Node build and dependency output
apps/admin-api/node_modules/
apps/admin-api/dist/
apps/admin-api/coverage/
*.tsbuildinfo

# Generated caches and temporary files
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
*.tmp
*.bak

# Local runtime data, logs, and editor files
data/
logs/
backups/
*.log
.DS_Store
.idea/
.vscode/
